{
  "name": "cookbook",
  "version": "1.0.0",
  "description": "This is a my first web project.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:emulators": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-cookbook \"vite --config vite.config.js --mode emulators --host\"",
    "build": "vite build",
    "serve": "vite preview",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "check:avatars": "node scripts/avatars/check-avatars.mjs",
    "check:tokens": "node packages/cookbook-tokens/sync-tokens.mjs --check",
    "verify:phase0": "node factory/scripts/verify-phase0.mjs",
    "dtu:start": "node factory/dtu/start-dtu.mjs --seed=baseline",
    "test:dtu": "node factory/dtu/start-dtu.mjs --exec=\"node --experimental-vm-modules node_modules/.bin/jest -c jest.dtu.config.mjs\"",
    "mobile:build:android": "node factory/scripts/build-android-local.mjs",
    "mobile:smoke:android": "node factory/scripts/run-android-smoke-local.mjs",
    "mobile:distribute:staging": "node factory/scripts/distribute-staging-android.mjs",
    "mobile:release:staging": "node factory/scripts/release-staging-android.mjs",
    "factory:calibrate": "node factory/validator/calibrate-mutations.mjs",
    "factory:gate": "node factory/orchestrator/orchestrator.mjs --mode=inner-gate",
    "factory:review": "node factory/orchestrator/orchestrator.mjs --mode=review",
    "factory:validate:android": "node factory/orchestrator/orchestrator.mjs --mode=validate-android",
    "factory:verify:ios": "node factory/orchestrator/orchestrator.mjs --mode=verify-ios",
    "sync:shared": "node scripts/sync-shared.mjs",
    "test:functions": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-cookbook \"node --experimental-vm-modules node_modules/.bin/jest -c jest.functions.config.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-cookbook \"node --experimental-vm-modules node_modules/.bin/jest -c jest.rules.config.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roiguri/cookbook.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/roiguri/cookbook/issues"
  },
  "homepage": "https://github.com/roiguri/cookbook#readme",
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@eslint/css": "^0.7.0",
    "@eslint/js": "^9.25.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.57.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/vite-plugin": "^5.2.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.25.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@dicebear/avataaars": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@sentry/browser": "^10.52.0",
    "cropperjs": "^1.6.2",
    "firebase": "^11.6.1"
  },
  "overrides": {
    "@eslint/plugin-kit": "^0.3.4",
    "@tootallnate/once": "^3.0.1",
    "@grpc/grpc-js": "^1.14.6"
  }
}
