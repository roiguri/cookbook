# `npm run dev:emulators`: the app against local Firebase emulators (Auth, Firestore,
# Storage, Functions) with this checkout's security rules. A `demo-` project needs no credentials
# and never reaches a real Firebase project. Sign up in the app to get a user.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cookbook.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cookbook
VITE_FIREBASE_STORAGE_BUCKET=demo-cookbook.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_ICON_PATH=dev
VITE_MANIFEST_FILE=dev.webmanifest.json
