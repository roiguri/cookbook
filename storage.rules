rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validate media files (Size < 50MB, Image or Video type)
    function isValidMediaFile(resource) {
      return resource.size < 50 * 1024 * 1024
          && (resource.contentType.matches('image/.*') || resource.contentType.matches('video/.*'));
    }

    // Role check against Firestore (cross-service rule; one document read).
    function isManager() {
      return isAuthenticated()
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // The author of the recipe a file belongs to (`authorId`). A recipe's images are uploaded
    // before its document exists, so a missing recipe simply means "not the author".
    function isRecipeAuthor(recipeId) {
      let path = /databases/(default)/documents/recipes/$(recipeId);
      return isAuthenticated()
          && firestore.exists(path)
          && firestore.get(path).data.get('authorId', null) == request.auth.uid;
    }

    // Every upload is tagged with its uploader (StorageService.uploadFile sets
    // customMetadata.uploadedBy). Files from before this rule have no tag.
    function isTaggedAsCaller(res) {
      return res.metadata != null && res.metadata.get('uploadedBy', null) == request.auth.uid;
    }

    // A new upload: signed in, a valid media file, tagged with the caller's own id.
    // Create rules also check `resource == null`: an upload over an existing file can be
    // evaluated as a create, and must go through the stricter update rule instead.
    function isValidUpload() {
      return isAuthenticated()
          && isValidMediaFile(request.resource)
          && isTaggedAsCaller(request.resource);
    }

    // A recipe that isn't in the family book: private, or not created yet (its
    // images are uploaded before its document is written).
    function isNotPublished(recipeId) {
      let path = /databases/(default)/documents/recipes/$(recipeId);
      return !firestore.exists(path)
          || firestore.get(path).data.get('visibility', null) != 'published';
    }

    // Who may overwrite or delete an existing recipe file: managers; and, while the
    // recipe isn't published, the person who uploaded it (e.g. cleaning up after a
    // failed save) or the recipe's author. Once published, a recipe's files change
    // only through edit suggestions (approved by a manager), the author included.
    function canChangeRecipeFile(recipeId) {
      return isManager()
          || (isNotPublished(recipeId)
              && (isTaggedAsCaller(resource) || isRecipeAuthor(recipeId)));
    }

    // ========================================
    // RECIPE FILES (layout since release 2b — src/js/utils/recipes/storage-paths.js)
    // ========================================
    // recipes/{recipeId}/images/{file} and recipes/{recipeId}/media/{file}.
    match /recipes/{recipeId}/{kind}/{fileName} {
      allow read: if true;
      allow create: if kind in ['images', 'media'] && resource == null && isValidUpload();
      allow update: if kind in ['images', 'media'] && isValidUpload() && canChangeRecipeFile(recipeId);
      allow delete: if kind in ['images', 'media'] && canChangeRecipeFile(recipeId);
      // Managers can replace files (e.g. the AI image enhancer). Uploads from the app
      // use unique file names, so nobody else needs to overwrite.
      allow write: if isManager() && (request.resource == null || isValidMediaFile(request.resource));
    }

    // ========================================
    // EDIT-SUGGESTION UPLOADS (staged until a manager approves)
    // ========================================
    // suggestions/{suggestionId}/images|media/{file}. Approval copies them into the
    // recipe's folder server-side (promoteSuggestionFiles); the copies are re-tagged
    // to the manager, so the suggester keeps no rights over the live recipe's files.
    match /suggestions/{suggestionId}/{kind}/{fileName} {
      allow read: if isManager() || isTaggedAsCaller(resource);
      allow create: if kind in ['images', 'media'] && resource == null && isValidUpload();
      allow delete: if isManager() || isTaggedAsCaller(resource);
    }

    // ========================================
    // PRIVATE USER AREA (private recipes from release 3a)
    // ========================================
    // users/{uid}/… — only its owner writes; owner and managers read.
    match /users/{uid}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isManager());
      allow create: if request.auth != null && request.auth.uid == uid
                    && resource == null && isValidUpload();
      allow update: if request.auth != null && request.auth.uid == uid && isValidUpload();
      allow delete: if isAuthenticated() && (request.auth.uid == uid || isManager());
    }

    // ========================================
    // LEGACY RECIPE IMAGES (before release 2b; removed in the cleanup release)
    // ========================================
    // The app no longer writes here; public read, managers only write.
    match /img/recipes/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && (request.resource == null || isValidMediaFile(request.resource));
    }


    // ========================================
    // USER AVATARS
    // ========================================
    match /Avatars/{allPaths=**} {
      allow read: if true;
    }

    // ========================================
    // Grandmother's Cookbook
    // ========================================
    match /grandmas_cookbook/{allPaths=**} {
      allow read: if isAuthenticated();
    }

    // ========================================
    // LEGACY MEDIA INSTRUCTIONS (before release 2b; removed in the cleanup release)
    // ========================================
    // The app no longer writes here; kept readable until cleanup, managers only write.
    match /recipes/{recipeId}/media-instructions/{fileName} {
      allow read: if true;
      allow write: if isManager();
    }
  }
}
