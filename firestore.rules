rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role checks using the users collection
    // Note: get() incurs a document read charge
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isManager() {
      return isAuthenticated() && getUserData().role == 'manager';
    }
    
    function isApproved() {
      let role = getUserData().role;
      return isAuthenticated() && (role == 'approved' || role == 'manager');
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // The avatar builder's choices (src/js/utils/avatar/chef-avatar.js): a version
      // and two small maps of part / colour ids. Ids themselves are checked by the app.
      function isValidAvatarConfig(data) {
        let config = data.get('avatarConfig', null);
        return config == null
            || (config is map
                && config.keys().hasOnly(['v', 'parts', 'colors'])
                && config.get('v', 0) is int
                && config.get('parts', {}) is map && config.get('parts', {}).size() <= 16
                && config.get('colors', {}) is map && config.get('colors', {}).size() <= 8);
      }

      // READ: 
      // - Users can read their own profile (for favorites, settings)
      // - Managers can read all profiles (for dashboard)
      // - Public read for basic profile? (Use specific query if needed, currently restricted)
      allow read: if isOwner(userId) || isManager();
      
      // CREATE:
      // - Users can create their own profile on signup
      // - Must set role to 'user' (default) - prevent self-promotion
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && isValidAvatarConfig(request.resource.data);
      
      // UPDATE:
      // - Users can update their own profile (avatar, favorites, name, fcmTokens)
      // - CRITICAL: Users CANNOT change their role
      // - Managers can update anything (including roles)
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role
                        && isValidAvatarConfig(request.resource.data))
                    || isManager();
                    
      // DELETE:
      // - Users can delete their own account
      // - Managers can delete users
      allow delete: if isOwner(userId) || isManager();
    }

    // =========================================================================
    // ACTIVE MEALS COLLECTION
    // =========================================================================
    match /active_meals/{userId} {
      // Users can only access their own active meal data
      allow read, write, delete: if isOwner(userId);
    }
    
    // =========================================================================
    // COOKBOOK COLLECTION (Legacy/Static PDF Index)
    // =========================================================================
    match /cookbook/{document=**} {
      allow read: if isApproved();
    }

    // =========================================================================
    // RECIPES COLLECTION
    // =========================================================================
    match /recipes/{recipeId} {
      // The author (`authorId`). Every recipe has one since the 2026-10-11
      // migration; the legacy `userId` / `approved` fields are no longer read.
      function authorOf(data) {
        return data.get('authorId', null);
      }
      function isAuthor() {
        return isAuthenticated() && authorOf(resource.data) == request.auth.uid;
      }
      function isPublished(data) {
        return data.get('visibility', null) == 'published';
      }
      // Valid model fields: a visibility and a stage from their sets.
      function isConsistent(data) {
        return data.get('visibility', 'private') in ['private', 'published']
            && data.get('stage', 'tested') in ['to-try', 'tested'];
      }

      // Shared with the caller (recipe sharing): a share record for them exists,
      // and they are still approved family or a manager. Rules functions read the
      // record whatever its own read rule says.
      function isSharedWithMe(recipeId) {
        return isAuthenticated()
            && exists(/databases/$(database)/documents/recipes/$(recipeId)/shares/$(request.auth.uid))
            && isApproved();
      }

      // READ:
      // - Published recipes are public.
      // - A private recipe is visible only to its author, managers, and approved
      //   family it was shared with (read one by one, never listed).
      // - List queries must filter on `visibility == 'published'` unless run by a
      //   manager; Firestore rejects a query that could return a recipe the caller
      //   can't read.
      // - A recipe that doesn't exist reads as "not found" rather than "permission
      //   denied" (a broken link isn't an error; nothing is revealed).
      allow read: if resource == null
                  || isPublished(resource.data)
                  || isAuthor()
                  || isManager()
                  || isSharedWithMe(recipeId);

      // Created together with its pending submission, in the same batch.
      function submittedTogether(recipeId) {
        let path = /databases/$(database)/documents/recipe_submissions/$(recipeId);
        return existsAfter(path) && getAfter(path).data.authorId == request.auth.uid;
      }

      // CREATE:
      // - A signed-in user creates a private recipe in their own name.
      //   Approved family can keep it private (My recipes: to try / library);
      //   a plain user can only propose it — the recipe and its submission
      //   must be written in one batch.
      // - Managers can create published recipes.
      allow create: if isConsistent(request.resource.data)
                    && (isManager()
                        || (isAuthenticated()
                            && request.resource.data.authorId == request.auth.uid
                            && !isPublished(request.resource.data)
                            && (isApproved() || submittedTogether(recipeId))));

      // UPDATE:
      // - Managers can edit any recipe, including publishing it.
      // - An author can edit their own private recipe, but can't publish it or
      //   change its author. Published recipes change through edit
      //   suggestions (recipe_edit_suggestions), the author included.
      // - The stage (to try / tested) is the author's alone, so on their published
      //   recipe the author may change only `stage` and `testedAt` (mark tested).
      allow update: if isConsistent(request.resource.data)
                    && (isManager()
                        || (isAuthor()
                            && !isPublished(resource.data)
                            && !isPublished(request.resource.data)
                            && authorOf(request.resource.data) == authorOf(resource.data))
                        || (isAuthor()
                            && isPublished(resource.data)
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['stage', 'testedAt'])));

      // DELETE:
      // - Managers can delete any recipe.
      // - An author can delete their own private recipe (My recipes). Published
      //   recipes belong to the family book and stay manager-only.
      allow delete: if isManager() || (isAuthor() && !isPublished(resource.data));

      // -----------------------------------------------------------------------
      // SHARES (recipe sharing, docs/archive/feature-plans/recipe-sharing.md, R3)
      // -----------------------------------------------------------------------
      // One record per recipient: the author of a private recipe gives approved
      // family (or managers) a live, read-only view. Records are created or
      // deleted, never edited.
      match /shares/{recipientUid} {
        function recipeData() {
          return get(/databases/$(database)/documents/recipes/$(recipeId)).data;
        }
        function canReceive(uid) {
          return get(/databases/$(database)/documents/users/$(uid)).data.role
                   in ['approved', 'manager'];
        }

        // READ: the recipient (their own record, also when it doesn't exist), the
        // author (who has access — list queries filter on authorId), managers.
        allow read: if isAuthenticated()
                    && (recipientUid == request.auth.uid
                        || resource.data.authorId == request.auth.uid
                        || isManager());

        // CREATE: only the recipe's author (approved family or a manager), only on a
        // private recipe, for someone else who is approved family or a manager.
        allow create: if isApproved()
                      && recipientUid != request.auth.uid
                      && request.resource.data.keys().hasOnly(['recipientUid', 'authorId', 'authorName', 'sharedAt'])
                      && request.resource.data.keys().hasAll(['recipientUid', 'authorId', 'authorName', 'sharedAt'])
                      && request.resource.data.recipientUid == recipientUid
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() > 0
                      && request.resource.data.authorName.size() <= 100
                      && request.resource.data.sharedAt == request.time
                      && recipeData().get('authorId', null) == request.auth.uid
                      && recipeData().get('visibility', null) == 'private'
                      && canReceive(recipientUid);

        allow update: if false;

        // DELETE: the author (removing someone), the recipient (leaving), managers.
        allow delete: if isAuthenticated()
                      && (resource.data.authorId == request.auth.uid
                          || recipientUid == request.auth.uid
                          || isManager());
      }
    }

    // "Shared with me": a collection-group query on shares filtered to the caller.
    match /{path=**}/shares/{recipientUid} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
    }

    // =========================================================================
    // RECIPE SUBMISSIONS (the family-book approval queue)
    // =========================================================================
    // One document per submitted recipe, keyed by the recipe's id. Same pattern as
    // recipe_edit_suggestions: an author can only create a pending submission for
    // their own private recipe; only managers change its status.
    match /recipe_submissions/{recipeId} {
      allow read: if isManager()
                  || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      allow create: if isAuthenticated()
                    && request.resource.data.recipeId == recipeId
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data
                         .get('authorId', null) == request.auth.uid
                    && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data
                         .get('visibility', null) == 'private';

      // Managers review (approve / reject). A rejection must say what to fix.
      // The author may resubmit a rejected recipe: back to pending, marked as a
      // resubmission; the manager's last note and review fields are kept.
      allow update: if (isManager()
                        && (request.resource.data.status != 'rejected'
                            || request.resource.data.get('rejectionReason', '') is string
                               && request.resource.data.get('rejectionReason', '').size() > 0))
                    || (isAuthenticated()
                        && resource.data.authorId == request.auth.uid
                        && resource.data.status == 'rejected'
                        && request.resource.data.status == 'pending'
                        && request.resource.data.resubmittedAt == request.time
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'resubmittedAt']));

      // Managers, or the author: cancelling a pending submission, or removing a
      // rejected one (e.g. before deleting the recipe). An approved submission is
      // the published recipe's record and stays.
      allow delete: if isManager()
                    || (isAuthenticated()
                        && resource.data.authorId == request.auth.uid
                        && resource.data.status in ['pending', 'rejected']);
    }

    // =========================================================================
    // RECIPE EDIT SUGGESTIONS
    // =========================================================================
    // Moderation queue for "suggest an edit". A separate collection (not a field
    // on the recipe) so a normal user can never self-approve: the live recipe is
    // only written by a manager via RecipeService.update on approval.
    match /recipe_edit_suggestions/{suggestionId} {
      // READ: managers (dashboard) + the suggester (to see their own status)
      allow read: if isManager()
                  || (isAuthenticated() && resource.data.suggestedBy == request.auth.uid);

      // CREATE: any signed-in user, but only as a pending suggestion they authored
      allow create: if isAuthenticated()
                    && request.resource.data.suggestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';

      // UPDATE: managers only (approve/reject)
      allow update: if isManager();

      // DELETE: managers, or the suggester withdrawing their own pending suggestion
      allow delete: if isManager()
                    || (isAuthenticated()
                        && resource.data.suggestedBy == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // =========================================================================
    // FAILED URL EXTRACTIONS
    // =========================================================================
    match /failed_url_extractions/{document=**} {
      // Only managers can view and clean up failed URL logs
      allow read, delete: if isManager();
    }
    
    // =========================================================================
    // RECIPE API TOKENS
    // =========================================================================
    // Hashed personal API tokens (functions/utils/api-tokens.js). Only Cloud
    // Functions read or write them — no client, managers included.
    match /api_tokens/{tokenId} {
      allow read, write: if false;
    }

    // =========================================================================
    // DEFAULT LOCK
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}