rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role checks using the users collection
    // Note: get() incurs a document read charge
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isManager() {
      return isAuthenticated() && getUserData().role == 'manager';
    }
    
    function isApproved() {
      let role = getUserData().role;
      return isAuthenticated() && (role == 'approved' || role == 'manager');
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // READ: 
      // - Users can read their own profile (for favorites, settings)
      // - Managers can read all profiles (for dashboard)
      // - Public read for basic profile? (Use specific query if needed, currently restricted)
      allow read: if isOwner(userId) || isManager();
      
      // CREATE:
      // - Users can create their own profile on signup
      // - Must set role to 'user' (default) - prevent self-promotion
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user';
      
      // UPDATE:
      // - Users can update their own profile (avatar, favorites, name, fcmTokens)
      // - CRITICAL: Users CANNOT change their role
      // - Managers can update anything (including roles)
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
                    || isManager();
                    
      // DELETE:
      // - Users can delete their own account
      // - Managers can delete users
      allow delete: if isOwner(userId) || isManager();

      // =========================================================================
      // USER COLLECTION (personal recipe collection — see
      // docs/feature-plans/personal-collections.md, "The core model")
      // =========================================================================
      match /collection/{recipeId} {
        // READ / DELETE: owner only. A personal overlay (notes, lifecycle
        // state) is private — managers are deliberately excluded here,
        // unlike the parent users doc which they can read for the
        // dashboard.
        allow read, delete: if isOwner(userId);

        // CREATE: owner only. Create-only ("save is create-only") is
        // enforced by CollectionService, not here — a blind overwrite of
        // an existing entry is classified by Firestore as an update, not
        // a create, so it falls through to the update rule below.
        allow create: if isOwner(userId);

        // UPDATE: owner only, and `source` ('owned' | 'saved') is set once
        // at create and must never change — cheap to prove without an
        // extra read.
        allow update: if isOwner(userId)
                      && request.resource.data.source == resource.data.source;
      }
    }

    // =========================================================================
    // ACTIVE MEALS COLLECTION
    // =========================================================================
    match /active_meals/{userId} {
      // Users can only access their own active meal data
      allow read, write, delete: if isOwner(userId);
    }
    
    // =========================================================================
    // COOKBOOK COLLECTION (Legacy/Static PDF Index)
    // =========================================================================
    match /cookbook/{document=**} {
      allow read: if isApproved();
    }

    // =========================================================================
    // RECIPES COLLECTION
    // =========================================================================
    match /recipes/{recipeId} {
      // READ (Stage 0 of the personal-collections plan):
      // Gates on `approved`, NOT `visibility` — every live list query filters
      // `where approved == true`, and Firestore list rules must be provable
      // from the query's own constraints. The visibility-keyed rule arrives
      // in Stage 4 via a bridge rule. Owners see their own unapproved
      // recipes; managers see everything.
      allow read: if resource.data.approved == true
                  || isOwner(resource.data.userId) || isManager();

      // CREATE:
      // Any authenticated user, but only as themselves and never published.
      // `in ['private', 'pending']`, not == 'private': the propose flow keeps
      // creating at 'pending' until it is retired (plan Slice 3.3) — tighten
      // to 'private' there.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.visibility in ['private', 'pending']
                    && request.resource.data.approved == false;

      // UPDATE:
      // - Managers can edit any recipe
      // - Owners can edit their own, but only within transitionOk()'s bounds
      allow update: if isManager()
                    || (isOwner(resource.data.userId) && transitionOk());

      // DELETE:
      // - Managers always; owners only while unpublished (`approved` is the
      //   live publication flag until Stage 4 — others may have saved a
      //   public recipe, so published deletion stays manager-only).
      allow delete: if isManager()
                    || (isOwner(resource.data.userId) && resource.data.approved == false);

      // Owner-update guard. `.get()` with a default so a doc the backfill
      // missed cannot brick its owner's updates (bare missing-key access
      // denies in rules).
      function transitionOk() {
        let from = resource.data.get('visibility', 'pending');
        let to = request.resource.data.get('visibility', 'pending');
        return request.resource.data.userId == resource.data.userId
            // an owner may NEVER touch `approved` — it is the live
            // publication flag until Stage 4, and omitting this reopens
            // the self-publish bug this rule exists to close
            && request.resource.data.approved == resource.data.approved
            // review metadata is manager-authored. The owner may REMOVE
            // `shareReview` (withdraw must) but never write or alter it,
            // and may never touch `publishedAt`.
            && (request.resource.data.get('shareReview', null) == null
                || request.resource.data.shareReview == resource.data.get('shareReview', null))
            && request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null)
            && (to == from
                || (from == 'private' && to == 'pending')
                || (from == 'pending' && to == 'private'));
      }
    }

    // =========================================================================
    // RECIPE EDIT SUGGESTIONS
    // =========================================================================
    // Moderation queue for "suggest an edit". A separate collection (not a field
    // on the recipe) so a normal user can never self-approve: the live recipe is
    // only written by a manager via RecipeService.update on approval.
    match /recipe_edit_suggestions/{suggestionId} {
      // READ: managers (dashboard) + the suggester (to see their own status)
      allow read: if isManager()
                  || (isAuthenticated() && resource.data.suggestedBy == request.auth.uid);

      // CREATE: any signed-in user, but only as a pending suggestion they authored
      allow create: if isAuthenticated()
                    && request.resource.data.suggestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';

      // UPDATE: managers only (approve/reject)
      allow update: if isManager();

      // DELETE: managers, or the suggester withdrawing their own pending suggestion
      allow delete: if isManager()
                    || (isAuthenticated()
                        && resource.data.suggestedBy == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // =========================================================================
    // FAILED URL EXTRACTIONS
    // =========================================================================
    match /failed_url_extractions/{document=**} {
      // Only managers can view and clean up failed URL logs
      allow read, delete: if isManager();
    }
    
    // =========================================================================
    // DEFAULT LOCK
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}